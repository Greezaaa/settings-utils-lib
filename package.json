{
  "name": "utils-lib",
  "version": "0.0.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"web/src/**/*.ts\"",
    "format:check": "prettier --check \"web/src/**/*.ts\"",
    "build:core": "ng build @su-labs/core --configuration production",
    "build:theme": "ng build @su-labs/theme --configuration production",
    "build:notifications": "ng build @su-labs/notifications --configuration production",
    "build:dialog": "ng build @su-labs/dialog --configuration production",
    "build:font-size": "ng build @su-labs/font-size --configuration production",
    "build:scroll-spy": "ng build @su-labs/scroll-spy --configuration production",
    "build:fields": "ng build @su-labs/fields --configuration production",
    "build:visit-tracker": "ng build @su-labs/visit-tracker --configuration production",
    "build:table": "ng build @su-labs/table --configuration production",
    "build:skeleton": "ng build @su-labs/skeleton --configuration production",
    "build:prettier-single-line-imports": "tsc -p projects/su-labs/prettier-plugin-single-line-imports/tsconfig.lib.json && cd projects/su-labs/prettier-plugin-single-line-imports && cp package.json README.md CHANGELOG.md LICENSE ../../../dist/su-labs/prettier-plugin-single-line-imports/",
    "build:vscode-ts-one-line-imports": "tsc -p projects/su-labs/vscode-ts-one-line-imports/tsconfig.json && node projects/su-labs/vscode-ts-one-line-imports/build.mjs",
    "package:vscode-ts-one-line-imports": "npm run build:vscode-ts-one-line-imports && cd dist/su-labs/vscode-ts-one-line-imports && vsce package --no-dependencies --out ../",
    "build:all": "npm run build:core && npm run build:theme && npm run build:notifications && npm run build:dialog && npm run build:scroll-spy && npm run build:fields && npm run build:font-size && npm run build:visit-tracker && npm run build:table && npm run build:skeleton && npm run build:prettier-single-line-imports && npm run build:vscode-ts-one-line-imports",
    "start:web": "ng serve web",
    "build:web": "ng build web && node scripts/postbuild-site.mjs web",
    "deploy:web": "npm run build:web && rsync -a --delete dist/web/browser/ su-labs-server:/home/ubuntu/su-labs-site/ && echo \"Deployed to https://su-labs.dev/\"",
    "deploy": "npm run deploy:web"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "24.19.2",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@vitest/coverage-v8": "4.0.18",
    "@vscode/vsce": "4.1.0",
    "angular-eslint": "22.6.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unused-imports": "4.3.0",
    "jsdom": "26.1.0",
    "ng-packagr": "22.2.6",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  }
}
