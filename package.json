{
  "name": "utils-lib",
  "version": "0.0.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.html --fix",
    "build:theme": "ng build @su-labs/theme --configuration production",
    "build:notifications": "ng build @su-labs/notifications --configuration production",
    "build:font-size": "ng build @su-labs/font-size --configuration production",
    "build:scroll-spy": "ng build @su-labs/scroll-spy --configuration production",
    "build:visit-tracker": "ng build @su-labs/visit-tracker --configuration production",
    "build:all": "npm run build:theme && npm run build:notifications && npm run build:scroll-spy && npm run build:font-size && npm run build:visit-tracker"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.1.2",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^21.1.2",
    "@angular/platform-browser": "^21.1.2",
    "@angular/router": "^21.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "angular-eslint": "20.1.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^21.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2"
  }
}