{
  "name": "utils-lib",
  "version": "0.0.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.html --fix",
    "build:core": "ng build @su-labs/core --configuration production",
    "build:theme": "ng build @su-labs/theme --configuration production",
    "build:notifications": "ng build @su-labs/notifications --configuration production",
    "build:font-size": "ng build @su-labs/font-size --configuration production",
    "build:scroll-spy": "ng build @su-labs/scroll-spy --configuration production",
    "build:visit-tracker": "ng build @su-labs/visit-tracker --configuration production",
    "build:prettier-single-line-imports": "tsc -p projects/su-labs/prettier-plugin-single-line-imports/tsconfig.lib.json && cd projects/su-labs/prettier-plugin-single-line-imports && cp package.json README.md CHANGELOG.md LICENSE ../../../dist/su-labs/prettier-plugin-single-line-imports/",
    "build:all": "npm run build:core && npm run build:theme && npm run build:notifications && npm run build:scroll-spy && npm run build:font-size && npm run build:visit-tracker && npm run build:prettier-single-line-imports",
    "start:web": "ng serve web",
    "build:web": "ng build web && node web/scripts/postbuild.mjs",
    "deploy:web": "npm run build:web && rsync -a --delete dist/web/browser/ su-labs-server:/home/ubuntu/su-labs-site/ && echo \"Deployed to https://su-labs.dev/\""
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^26.1.0",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
