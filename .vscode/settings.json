{
  // Format on save with TS One-Line Imports (su-labs.ts-one-line-imports): it runs Prettier with the config nearest the
  // file (prettier.config.js here, api/.prettierrc in api/) and always adds the single-line-imports plugin, so imports
  // end up on one line everywhere, api/ included.
  "editor.defaultFormatter": "su-labs.ts-one-line-imports",
  "editor.formatOnSave": true,
  // Runs before formatting: TypeScript adds, merges and sorts imports, then Prettier puts each on one line.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "su-labs.ts-one-line-imports"
  }
}
