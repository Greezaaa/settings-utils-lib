/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [],
    /* Compile the libraries from source so the site always shows the current code (no library build needed) */
    "paths": {
      "@su-labs/core": ["../projects/su-labs/core/src/public-api.ts"],
      "@su-labs/core/*": ["../projects/su-labs/core/*/src/public-api.ts"],
      "@su-labs/dialog": ["../projects/su-labs/dialog/src/public-api.ts"],
      "@su-labs/font-size": ["../projects/su-labs/font-size/src/public-api.ts"],
      "@su-labs/notifications": ["../projects/su-labs/notifications/src/public-api.ts"],
      "@su-labs/scroll-spy": ["../projects/su-labs/scroll-spy/src/public-api.ts"],
      "@su-labs/theme": ["../projects/su-labs/theme/src/public-api.ts"],
      "@su-labs/visit-tracker": ["../projects/su-labs/visit-tracker/src/public-api.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
