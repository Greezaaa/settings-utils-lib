# Copy to .env on the server (never commit .env) and fill in.

# Database password; any long random string, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Secret for the moderation endpoints (/admin/...), at least 32 characters, e.g. `openssl rand -hex 32`
ADMIN_TOKEN=

# Sites allowed to call the API from a browser
CORS_ORIGINS=https://games.su-labs.dev,https://su-labs.dev

# Cloudflare Turnstile secret key for the suggestions form; leave empty to skip the bot check
TURNSTILE_SECRET=
# (COOKIE_SECURE defaults to true; only set COOKIE_SECURE=false for a local API on http://localhost)

# Player accounts: a mail server for password-reset emails, e.g. smtps://user:password@smtp.example.com:465
# Leave empty and accounts have no email (a forgotten password then can't be reset)
SMTP_URL=
# Who the emails come from, and the games site for the links in them
MAIL_FROM=su-labs games <games@su-labs.dev>
GAMES_URL=https://games.su-labs.dev
