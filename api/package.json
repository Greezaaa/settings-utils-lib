{
  "name": "su-labs-api",
  "version": "0.0.1",
  "description": "api.su-labs.dev: anonymous play counts, feedback, word reports and suggestions for games.su-labs.dev",
  "author": "Yevheniy Alekseyev",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "create-admin": "node dist/cli/create-admin.js",
    "start:rooms": "nest start --watch --entryFile rooms-main",
    "start:auth": "nest start --watch --entryFile auth-main"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/platform-ws": "12.4.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.4.0",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "1.1.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/mau": "0.2.9",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
