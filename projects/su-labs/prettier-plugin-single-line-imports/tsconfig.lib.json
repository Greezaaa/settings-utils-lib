/* Builds the plugin as a plain Node ES module (no Angular): dist/su-labs/prettier-plugin-single-line-imports */
{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../../dist/su-labs/prettier-plugin-single-line-imports",
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
