{
	"name": "ts-one-line-imports",
	"displayName": "TS One-Line Imports",
	"description": "Formats TypeScript and JavaScript with each project's own Prettier config and keeps every import on a single line. Projects without Prettier only get their imports joined.",
	"version": "1.0.1",
	"publisher": "su-labs",
	"icon": "images/icon.png",
	"preview": true,
	"galleryBanner": {
		"color": "#111111",
		"theme": "dark"
	},
	"license": "MIT",
	"author": {
		"name": "Yevheniy Alekseyev",
		"email": "yev.alekseyev@gmail.com",
		"url": "https://github.com/Greezaaa"
	},
	"homepage": "https://su-labs.dev/one-line-imports/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Greezaaa/settings-utils-lib.git",
		"directory": "projects/su-labs/vscode-ts-one-line-imports"
	},
	"bugs": {
		"url": "https://github.com/Greezaaa/settings-utils-lib/issues"
	},
	"keywords": [
		"prettier",
		"imports",
		"single-line",
		"formatter",
		"typescript",
		"javascript",
		"angular",
		"typescript-hero"
	],
	"categories": [
		"Formatters"
	],
	"engines": {
		"vscode": "^1.90.0"
	},
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:javascript",
		"onLanguage:javascriptreact"
	],
	"contributes": {
		"configuration": {
			"title": "TS One-Line Imports",
			"properties": {
				"tsOneLineImports.removeUnusedImports": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"markdownDescription": "Remove unused imports when formatting, like VS Code's **Remove Unused Imports** command. Side-effect imports such as `import './polyfills';` are kept."
				}
			}
		}
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Loading a project's Prettier config and plugins runs code from that project."
		}
	},
	"main": "./extension.js",
	"files": [
		"extension.js",
		"images/icon.png",
		"LICENSE",
		"CHANGELOG.md"
	]
}
