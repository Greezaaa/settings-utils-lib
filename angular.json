{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"web": {
			"projectType": "application",
			"root": "web",
			"sourceRoot": "web/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "web/src/main.ts",
						"tsConfig": "web/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "web/public"
							}
						],
						"styles": [
							"web/src/styles.scss"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "web:build:production"
						},
						"development": {
							"buildTarget": "web:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		},
		"@su-labs/core": {
			"projectType": "library",
			"root": "projects/su-labs/core",
			"sourceRoot": "projects/su-labs/core/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/su-labs/core/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/su-labs/core/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				}
			}
		},
		"settings-utils": {
			"projectType": "library",
			"root": "projects/settings-utils",
			"sourceRoot": "projects/settings-utils/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/settings-utils/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/settings-utils/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/settings-utils/tsconfig.spec.json"
					}
				}
			}
		},
		"@su-labs/font-size": {
			"projectType": "library",
			"root": "projects/su-labs/font-size",
			"sourceRoot": "projects/su-labs/font-size/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/su-labs/font-size/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/su-labs/font-size/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				}
			}
    },
    "@su-labs/scroll-spy": {
      "projectType": "library",
      "root": "projects/su-labs/scroll-spy",
      "sourceRoot": "projects/su-labs/scroll-spy/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/su-labs/scroll-spy/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/su-labs/scroll-spy/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/su-labs/scroll-spy/tsconfig.spec.json"
          }
        }
      }
    },
    "@su-labs/notifications": {
      "projectType": "library",
      "root": "projects/su-labs/notifications",
      "sourceRoot": "projects/su-labs/notifications/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/su-labs/notifications/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/su-labs/notifications/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/su-labs/notifications/tsconfig.spec.json"
          }
        }
      }
    },
    "@su-labs/visit-tracker": {
      "projectType": "library",
      "root": "projects/su-labs/visit-tracker",
      "sourceRoot": "projects/su-labs/visit-tracker/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/su-labs/visit-tracker/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/su-labs/visit-tracker/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/su-labs/visit-tracker/tsconfig.spec.json"
          }
        }
      }
    },
    "@su-labs/theme": {
      "projectType": "library",
      "root": "projects/su-labs/theme",
      "sourceRoot": "projects/su-labs/theme/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/su-labs/theme/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/su-labs/theme/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/su-labs/theme/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}